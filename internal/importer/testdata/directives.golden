== toml ==
# EPG from the #EXTM3U header; it belongs in config.toml:
# [epg]
# url = "https://epg.example.org/a.xml"
# url = "https://epg.example.org/b.xml"

tunnel = "gr"

[[channel]]
name = "Directives"
url = "https://dir.example.com/master.m3u8"

[channel.playlist]
tvg_id = "dir"

[channel.playlist.extra.KODIPROP]
"inputstream.adaptive.manifest_type" = "hls"
"inputstreamaddon" = "inputstream.adaptive"

[channel.playlist.extra.MY-DIR2]
"some.dotted.key" = "value with spaces"
== warnings ==
line 1: #EXTM3U attribute "tvg-shift" dropped
line 5: line dropped: not #DIRECTIVE:key=value
line 6: comment dropped
line 7: line dropped: not #DIRECTIVE:key=value
line 8: #EXT-X-FOO line dropped: not allowed in playlist.extra
line 10: line dropped: not #DIRECTIVE:key=value
line 11: line dropped: not #DIRECTIVE:key=value
line 14: comment dropped
line 15: #KODIPROP line without a following channel dropped
