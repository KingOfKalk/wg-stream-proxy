== toml ==
# EPG from the #EXTM3U header; it belongs in config.toml:
# [epg]
# url = "https://epg.example.org/guide.xml.gz"

tunnel = "gr"

[defaults.upstream]
headers = { User-Agent = "OKHTTP" }

[defaults.playlist]
attrs = { parent-code = "0000" }

[[channel]]
name = "Alpha One"
url = "https://alpha-live.cdn.example.com/alpha/live/hls/master.m3u8"
group = "Example TV"

[channel.playlist]
tvg_id = "Alpha.example"
logo = "https://logos.example.org/tv/alpha.png"

[[channel]]
name = "Beta"
url = "https://beta-hls.edge.example.net/hls/live/1000001/xx/high/master.m3u8"
group = "Example TV"

[channel.playlist]
tvg_id = "Beta"
logo = "https://logos.example.org/tv/beta.png"

