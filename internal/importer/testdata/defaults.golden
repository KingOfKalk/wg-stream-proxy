== toml ==
tunnel = "gr"
group = "Shared"

[defaults.upstream]
headers = { User-Agent = "Shared" }

[defaults.playlist]
logo = "shared.png"
attrs = { parent-code = "1234" }

[defaults.playlist.extra.KODIPROP]
"inputstream.adaptive.manifest_type" = "hls"

[[channel]]
name = "One"
url = "https://defaults.example.com/1.m3u8"

[channel.upstream]
headers = { Referer = "https://a.example.org/" }

[channel.playlist]
attrs = { tvg-chno = "1" }

[[channel]]
name = "Two"
url = "https://defaults.example.com/2.m3u8"

[channel.upstream]
headers = { Referer = "https://b.example.org/" }

[channel.playlist]
attrs = { tvg-chno = "2" }
