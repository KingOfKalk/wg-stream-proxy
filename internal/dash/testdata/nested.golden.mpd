<?xml version="1.0" encoding="UTF-8"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" xmlns:dvb="urn:dvb:dash:dash-extensions:2014-1" type="dynamic" minimumUpdatePeriod="PT6S" availabilityStartTime="2026-01-01T00:00:00Z" profiles="urn:dvb:dash:profile:dvb-dash:2014">
  
  
  <BaseURL serviceLocation="cdn-a" dvb:priority="1" dvb:weight="1">http://wsp.lan/p/n/{https://cdn-a.example.com/live/ch2/}/</BaseURL>
  <BaseURL serviceLocation="cdn-b" dvb:priority="2" dvb:weight="1">http://wsp.lan/p/n/{https://cdn-b.example.com:8443/ch2/}/</BaseURL>
  <Period id="p1" start="PT0S">
    <BaseURL>http://wsp.lan/p/n/{https://cdn-a.example.com/live/ch2/period-1/}/</BaseURL>
    <AdaptationSet id="0" mimeType="video/mp4" contentType="video">
      <BaseURL>http://wsp.lan/p/n/{https://cdn-a.example.com/live/ch2/period-1/video/}/</BaseURL>
      <SegmentTemplate timescale="90000" duration="540000" startNumber="1" initialization="$RepresentationID$/init.mp4" media="$RepresentationID$/$Number%06d$.m4s"/>
      <Representation id="720p" bandwidth="3000000" width="1280" height="720" codecs="avc1.64001f"/>
      <Representation id="1080p" bandwidth="6000000" width="1920" height="1080" codecs="avc1.640028">
        <BaseURL>http://wsp.lan/p/n/{https://cdn-a.example.com/live/ch2/period-1/video-hd/}/</BaseURL>
      </Representation>
    </AdaptationSet>
    <AdaptationSet id="1" mimeType="audio/mp4" contentType="audio" lang="en">
      <BaseURL>http://wsp.lan/p/n/{https://cdn-a.example.com/shared/audio/}/</BaseURL>
      <SegmentTemplate timescale="48000" duration="288000" startNumber="1" initialization="init-$RepresentationID$.mp4" media="http://wsp.lan/p/n/{https://cdn-c.example.com/audio/}/$RepresentationID$/$Number$.m4s"/>
      <Representation id="en-128" bandwidth="128000" codecs="mp4a.40.2" audioSamplingRate="48000"/>
    </AdaptationSet>
  </Period>
  <UTCTiming schemeIdUri="urn:mpeg:dash:utc:http-iso:2014" value="http://wsp.lan/time"/>
  <UTCTiming schemeIdUri="urn:mpeg:dash:utc:direct:2014" value="2026-11-19T12:00:00Z"/>
</MPD>
